## The configuration of this file is generated automatically.
## Do not edit this file manually, use: u-boot-update

default l0
menu title U-Boot menu
prompt 1
timeout 10


label l0
	menu label Debian GNU/Linux 11 (bullseye) 5.15.147-21-a733
	linux /boot/vmlinuz-5.15.147-21-a733
	initrd /boot/initrd.img-5.15.147-21-a733
	fdtdir /usr/lib/linux-image-5.15.147-21-a733/
	fdtoverlays  /boot/dtbo/cubie-a7a-meizu-e3-display-v001-reg1-5.15.dtbo
	append root=UUID=2a1371bc-7ff5-43a2-a3f9-7778b6d70186 console=ttyAS0,115200n8 earlyprintk=sunxi-uart,0x2500000 rootwait clk_ignore_unused mac_addr=${mac} mac1_addr=${mac1} quiet splash loglevel=4 rw earlycon consoleblank=0 console=tty1 coherent_pool=2M irqchip.gicv3_pseudo_nmi=0 cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1 kasan=off

