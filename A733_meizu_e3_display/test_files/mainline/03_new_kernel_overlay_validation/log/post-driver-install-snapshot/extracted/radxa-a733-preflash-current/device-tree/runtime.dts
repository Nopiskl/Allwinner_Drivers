	eeprom-wp {
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		gpio = <0x36 0x02 0x07 0x00>;
		regulator-enable-ramp-delay = <0x3e8>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "eeprom_wp";
		compatible = "regulator-fixed";
		phandle = <0x239>;
	};

	reserved-memory {
