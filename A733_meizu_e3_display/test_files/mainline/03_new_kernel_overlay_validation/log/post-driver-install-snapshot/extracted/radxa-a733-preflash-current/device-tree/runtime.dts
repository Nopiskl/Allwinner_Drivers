/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "sun60iw2";
	serial-number = "32805100885926e4";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "radxa,cubie-a7a", "arm,sun60iw2p1";
	board = "A733", "A733-CUBIE-A7A-AXP318";

	clk_ddr {
		clock-names = "pll_ddr";
		clocks = <0x12 0x01>;
		#clock-cells = <0x00>;
		compatible = "allwinner,sun60iw2_clock_ddr";
		reg = <0x00 0x2002000 0x00 0x1000>;
		phandle = <0x28>;
	};

	iommu@3900000 {
		masters = "USB", "CSI", "ISP", "VE_ENC", "dummy04", "dummy05", "VE_DEC0", "VE_DEC1", "DE0", "DI", "G2D", "EINK", "DEBUG_MODE";
		ptw_invalid_mode = <0x01>;
		clock-names = "iommu0-sys-hclk", "iommu0-sys-pclk", "iommu0-sys-mclk", "iommu1-sys-hclk", "iommu1-sys-pclk", "iommu1-sys-mclk";
		resets = <0x12 0x03 0x12 0x0a>;
		interrupts = <0x00 0xaa 0x04 0x00 0xab 0x04>;
		clocks = <0x12 0x36 0x12 0x37 0x12 0x38 0x12 0x3c 0x12 0x3d 0x12 0x3e>;
		tlb_invalid_mode = <0x01>;
		#iommu-cells = <0x02>;
		compatible = "allwinner,iommu-v20";
		interrupt-names = "iommu-irq1", "iommu-irq2";
		reg = <0x00 0x3900000 0x00 0x20000>;
		phandle = <0x2c>;
		version = <0x16>;
		tlb_prefetch = <0x3007f>;

		usb_iommu {
			id = <0x00>;
			iommu-master;
		};

		ve_enc_iommu {
			power-domains = <0x13 0x03>;
			id = <0x03>;
			iommu-master;
		};

		ve_dec0_iommu {
			power-domains = <0x13 0x02>;
			id = <0x06>;
			iommu-master;
		};

		csi_iommu {
			power-domains = <0x13 0x00>;
			id = <0x01>;
			iommu-master;
		};

		dummy04 {
			id = <0x04>;
			skip;
			iommu-master;
		};

		ve_dec1_iommu {
			power-domains = <0x13 0x02>;
			id = <0x07>;
			iommu-master;
		};

		isp_iommu {
			power-domains = <0x13 0x00>;
			id = <0x02>;
			iommu-master;
		};

		g2d_iommu {
