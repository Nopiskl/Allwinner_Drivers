				trip-point@1 {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x1b>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x1b>;
					cooling-device = <0x1c 0x00 0x32 0x1d 0x00 0x32 0x1e 0x00 0x32 0x1f 0x00 0x32>;
