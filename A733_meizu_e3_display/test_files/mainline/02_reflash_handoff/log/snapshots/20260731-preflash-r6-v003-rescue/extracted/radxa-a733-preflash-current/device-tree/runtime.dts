			vbmeta {
				parts = "vbmeta,vbmeta_system,vbmeta_vendor,boot,init_boot";
				compatible = "android,vbmeta";
			};
		};
	};

	pck-600@7060000 {
		compatible = "allwinner,sun60iw2-pck\0syscon\0simple-mfd";
		reg = <0x00 0x7060000 0x00 0xb000>;
		phandle = <0x14a>;

		power-controller {
			#address-cells = <0x01>;
			clock-names = "pck";
			clocks = <0x27 0x13>;
			#size-cells = <0x00>;
			#power-domain-cells = <0x01>;
			compatible = "allwinner,sun60iw2-pck-600";
			phandle = <0x13>;

			pd_npu@4 {
				reg = <0x04>;
			};

			pd_vo1@10 {
				reg = <0x0a>;
			};

			pd_ve_enc@3 {
				reg = <0x03>;
			};

			pd_de_sys@1 {
				reg = <0x01>;
			};

			pd_vi@0 {
				reg = <0x00>;
			};

			pd_pcie@7 {
				reg = <0x07>;
			};

			pd_ve_dec@2 {
				reg = <0x02>;
			};

			pd_vo@9 {
				reg = <0x09>;
			};

			pd_usb2@8 {
				reg = <0x08>;
			};
		};
	};

	wifi_chip_en {
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		gpio = <0x35 0x01 0x01 0x00>;
		regulator-enable-ramp-delay = <0x3e8>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "wifi_chip_en";
		compatible = "regulator-fixed";
		phandle = <0x237>;
	};

	chosen {
		linux,initrd-end = <0x00 0x51e158ca>;
		bootargs = "root=UUID=2a1371bc-7ff5-43a2-a3f9-7778b6d70186 console=ttyAS0,115200n8 earlyprintk=sunxi-uart,0x2500000 rootwait clk_ignore_unused mac_addr=08:51:49:58:40:32 mac1_addr=08:51:49:58:40:33 splash loglevel=4 rw earlycon consoleblank=0 console=tty1 coherent_pool=2M irqchip.gicv3_pseudo_nmi=0 cgroup_enable=cpuset cgroup_memory=1 cgroup_enable=memory swapaccount=1 kasan=off single";
		kaslr-seed;
		linux,initrd-start = <0x00 0x4ff00000>;
	};

	interrupt-controller@3400000 {
		#address-cells = <0x00>;
		interrupt-parent = <0x02>;
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		reg = <0x00 0x3400000 0x00 0x10000 0x00 0x3460000 0x00 0xff004>;
		phandle = <0x02>;
		interrupt-controller;
	};

	arisc_config {
		phandle = <0x239>;

		s_uart_config {
			function = <0x03 0x03>;
			pins = "PL2\0PL3";
			status = "disabled";
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@300 {
			capacity-dmips-mhz = <0x1ae>;
			clocks = <0x05 0x01>;
			cpu-idle-states = <0x03 0x04>;
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			dynamic-power-coefficient = <0xa2>;
			reg = <0x00 0x300>;
			enable-method = "psci";
			phandle = <0x0d>;
			operating-points-v2 = <0x06>;
			#cooling-cells = <0x02>;

			thermal-idle {
				exit-latency-us = <0x1f4>;
				duration-us = <0x2710>;
				phandle = <0x1d>;
				#cooling-cells = <0x02>;
			};
		};

		cpu@600 {
			capacity-dmips-mhz = <0x400>;
