/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "sun60iw2";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "radxa,cubie-a7a\0arm,sun60iw2p1\0allwinner,sun60i-a733";
	board = "A733\0A733-CUBIE-A7A-AXP318";

	clk_ddr {
		clock-names = "pll_ddr";
		clocks = <0x12 0x01>;
		#clock-cells = <0x00>;
		compatible = "allwinner,sun60iw2_clock_ddr";
		reg = <0x00 0x2002000 0x00 0x1000>;
		phandle = <0x28>;
	};

	iommu@3900000 {
		masters = "USB\0CSI\0ISP\0VE_ENC\0dummy04\0dummy05\0VE_DEC0\0VE_DEC1\0DE0\0DI\0G2D\0EINK\0DEBUG_MODE";
		ptw_invalid_mode = <0x01>;
		clock-names = "iommu0-sys-hclk\0iommu0-sys-pclk\0iommu0-sys-mclk\0iommu1-sys-hclk\0iommu1-sys-pclk\0iommu1-sys-mclk";
		resets = <0x12 0x03 0x12 0x0a>;
		interrupts = <0x00 0xaa 0x04 0x00 0xab 0x04>;
		clocks = <0x12 0x36 0x12 0x37 0x12 0x38 0x12 0x3c 0x12 0x3d 0x12 0x3e>;
		tlb_invalid_mode = <0x01>;
		#iommu-cells = <0x02>;
		compatible = "allwinner,iommu-v20";
		interrupt-names = "iommu-irq1\0iommu-irq2";
		reg = <0x00 0x3900000 0x00 0x20000>;
		phandle = <0x2c>;
		version = <0x16>;
		tlb_prefetch = <0x3007f>;

		usb_iommu {
			id = <0x00>;
			iommu-master;
		};

		ve_enc_iommu {
			power-domains = <0x13 0x03>;
			id = <0x03>;
			iommu-master;
		};

		ve_dec0_iommu {
			power-domains = <0x13 0x02>;
			id = <0x06>;
			iommu-master;
		};

		csi_iommu {
			power-domains = <0x13 0x00>;
			id = <0x01>;
			iommu-master;
		};

		dummy04 {
			id = <0x04>;
			skip;
			iommu-master;
		};

		ve_dec1_iommu {
			power-domains = <0x13 0x02>;
			id = <0x07>;
			iommu-master;
		};

		isp_iommu {
			power-domains = <0x13 0x00>;
			id = <0x02>;
			iommu-master;
		};

		g2d_iommu {
			power-domains = <0x13 0x01>;
			id = <0x0a>;
			iommu-master;
		};

		di_iommu {
			power-domains = <0x13 0x01>;
			id = <0x09>;
			iommu-master;
		};

		eink_iommu {
			power-domains = <0x13 0x01>;
			id = <0x0b>;
			iommu-master;
		};

		dummy05 {
			id = <0x05>;
			skip;
			iommu-master;
		};

		de0_iommu {
			power-domains = <0x13 0x01>;
			id = <0x08>;
			iommu-master;
		};
	};

	wifi_power_en {
		regulator-max-microvolt = <0x325aa0>;
		regulator-boot-on;
		gpio = <0x35 0x01 0x00 0x00>;
		regulator-enable-ramp-delay = <0x3e8>;
		regulator-always-on;
		enable-active-high;
		regulator-min-microvolt = <0x325aa0>;
		regulator-name = "wifi_power_en";
		compatible = "regulator-fixed";
		phandle = <0x236>;
	};

	vdd-sys {
		regulator-max-microvolt = <0xdbba0>;
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <0xdbba0>;
		regulator-name = "vdd_sys";
		compatible = "regulator-fixed";
		phandle = <0x2a>;
	};

	timer_arch {
		arm,no-tick-in-suspend;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		interrupt-parent = <0x02>;
		clock-frequency = <0x16e3600>;
		compatible = "arm,armv8-timer";
	};

	dsufreq@0 {
		dsu-supply = <0x07>;
		clocks = <0x05 0x03>;
		compatible = "allwinner,dsufreq";
		reg = <0x00 0x8860000 0x00 0x1000>;
		phandle = <0x132>;
		operating-points-v2 = <0x14>;
	};

	opp_table {
		compatible = "operating-points-v2";
		phandle = <0x29>;

		opp@150000000 {
			opp-microvolt = <0xdbba0>;
			opp-hz = <0x00 0x8f0d180>;
			clock-latency-ns = <0x249f0>;
		};
	};

	dcxo26M_clk {
		clock-output-names = "dcxo26M";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		compatible = "fixed-clock";
		phandle = <0x130>;
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x01 0x00>;
	};

	vf_mapping_table {
		table = <0x00 0x00 0x01 0x100 0x11 0x101 0x02 0x200 0x12 0x201 0x03 0x300 0x04 0x400 0x05 0x500 0x06 0x600 0x14 0x401 0x15 0x501>;
		phandle = <0x12a>;
		vf-version = "V0.9";
	};

	thermal-zones {
		phandle = <0x133>;

		cpub_idle_zone {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x15 0x06>;
			phandle = <0x13d>;

			trips {
				phandle = <0x13e>;

				trip-point@0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x13f>;
				};

				trip-point@1 {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x20>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x20>;
					cooling-device = <0x21 0x00 0x64 0x22 0x00 0x64>;
					contribution = <0x400>;
				};
			};
		};

		cpul_idle_zone {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			thermal-sensors = <0x15 0x05>;
